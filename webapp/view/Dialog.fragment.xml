<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:layout="sap.ui.layout"
>
    <Dialog
        id="_IDGenDialog"
        title="QR Scan of the Item"
        class="centerTitle"
        verticalScrolling="false"
        horizontalScrolling="false"
    >
        <content>
            <HBox
                id="_IDGenVBox1"
                fitContainer="true"
                renderType="Bare"
            >
                <f:SimpleForm
                    id="SimpleFormDisplay354"
                    editable="false"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="1"
                    labelSpanL="1"
                    labelSpanM="2"
                    labelSpanS="4"
                    adjustLabelSpan="false"
                    emptySpanXL="4"
                    emptySpanL="4"
                    emptySpanM="2"
                    emptySpanS="1"
                    columnsXL="1"
                    columnsL="1"
                    columnsM="1"
                    singleContainerFullSize="false"
                >
                    <f:content>
                        <Label
                            id="_IDGenLabel"
                            text="Item Qty"
                        />
                        <Text id="itemQty" />
                        <Label
                            id="_IDGenLabel1"
                            text="Picked Qty"
                        />
                        <Text id="_IDGenText11" />
                    </f:content>
                </f:SimpleForm>
            </HBox>

            <VBox>
                <ScrollContainer
                    id="scroll1"
                    vertical="true"
                    horizontal="false"
                    width="100%"
                    height="25em"
                >
                    <Table
                        id="_IDGenTable"
                        inset="false"
                        mode="MultiSelect"
                    >
                        <headerToolbar>
                            <Toolbar id="_IDGenToolbar1">
                                <content>
                                    <ToolbarSpacer id="_IDGenToolbarSpacer" />
                                    <Input
                                        id="_IDGenButtonScn"
                                        placeholder="Batch Scan"
                                        showValueHelp="true"
                                        valueHelpIconSrc="sap-icon://qr-code"
                                        valueHelpRequest="onQtyScan"
                                        submit="onQRPressEnter"
                                    />
                                    <Button
                                        id="_IDGenButton1"
                                        text="Ok"
                                        type="Emphasized"
                                        press="onConfirm"
                                    />
                                </content>
                            </Toolbar>
                        </headerToolbar>
                        <columns>
                            <Column
                                id="_IDGenColumn6"
                                hAlign="Begin"
                                width="5em"
                            >
                                <Text
                                    id="_IDGenText8"
                                    text="Sr #"
                                />
                            </Column>
                            <Column id="_IDGenColumn7">
                                <Text
                                    id="_IDGenText9"
                                    text="Batch #"
                                />
                            </Column>
                            <Column id="_IDGenColumn8">
                                <Text
                                    id="_IDGenText10"
                                    text="Quantity"
                                />
                            </Column>
                        </columns>
                        <items>
                            <!-- <ColumnListItem id="_IDGenColumnListItem1">
                                <cells>
                                    <Text
                                        id="_IDGenText14"
                                        text="{postModel>SR_NO}"
                                    />
                                    <ObjectIdentifier
                                        id="_IDGenObjectIdentifier1"
                                        title="{postModel>BATCH}"
                                    />
                                    <Text
                                        id="_IDGenText15"
                                        text="{postModel>BATCHQTY}"
                                    />
                                </cells>
                            </ColumnListItem> -->
                        </items>
                    </Table>
                </ScrollContainer>
            </VBox>
        </content>
        <endButton>
            <Button
                id="_IDGenButton2"
                text="Close"
                press="onDialogClose"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
